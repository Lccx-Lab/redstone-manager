# Supabaseプロジェクトの Settings > API から取得してください
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabaseプロジェクトの Settings > API > service_role key（Cronからの通知処理専用。絶対に公開しないこと）
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend (https://resend.com) の API キー
# メインクエスト更新通知は各ユーザー自身のログインメールアドレス宛に送信される。
# 独自ドメインを検証していない場合、Resendのサンドボックス制限により
# 「Resendアカウント所有者自身のメールアドレス」以外には送信できないため、
# 他ユーザーにも実際にメールを届けるには送信元ドメインの検証が必要
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# 送信元アドレス（Resendでドメイン認証していない場合は既定の onboarding@resend.dev のままでOK）
# NOTIFICATION_FROM_EMAIL=REDSTONE Manager <onboarding@resend.dev>

# Cronエンドポイント保護用の秘密文字列（`openssl rand -hex 32` などで生成）
# Vercelにこの名前で環境変数を設定すると、Vercel Cronが自動でAuthorizationヘッダーに付与します
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# サインアップ時のメール確認リンクの戻り先を組み立てるためのサイトURL（末尾スラッシュなし）
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ブラウザ通知（Web Push）用のVAPID鍵ペア。`npx web-push generate-vapid-keys` で生成
# 公開鍵はクライアントに埋め込まれるため NEXT_PUBLIC_ が必須、秘密鍵は絶対に公開しないこと
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 通知送信元として名乗る連絡先（mailto: またはサイトURL）。プッシュサービスが問題発生時に利用します
VAPID_SUBJECT=mailto:you@example.com
