# Supabaseプロジェクトの Settings > API から取得してください
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabaseプロジェクトの Settings > API > service_role key（Cronからの通知処理専用。絶対に公開しないこと）
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend (https://resend.com) の API キー
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# メインクエスト更新通知の送信先メールアドレス
NOTIFICATION_EMAIL=you@example.com
# 送信元アドレス（Resendでドメイン認証していない場合は既定の onboarding@resend.dev のままでOK）
# NOTIFICATION_FROM_EMAIL=REDSTONE Manager <onboarding@resend.dev>

# Cronエンドポイント保護用の秘密文字列（`openssl rand -hex 32` などで生成）
# Vercelにこの名前で環境変数を設定すると、Vercel Cronが自動でAuthorizationヘッダーに付与します
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
